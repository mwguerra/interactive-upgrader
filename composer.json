{
    "name": "mwguerra/interactive-upgrader",
    "description": "A CLI tool that handles both Composer and npm dependencies for Laravel projects.",
    "type": "library",
    "version": "0.0.1",
    "license": "MIT",
    "keywords": [
        "laravel",
        "composer",
        "npm",
        "dependencies",
        "upgrade",
        "interactive"
    ],
    "autoload": {
        "psr-4": {
            "MWGuerra\\InteractiveUpgrader\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "authors": [
        {
            "name": "Marcelo Guerra",
            "email": "mwguerra@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "symfony/console": "^7.0",
        "symfony/process": "^7.0",
        "guzzlehttp/guzzle": "^7.0",
        "composer/composer": "^2.8",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "composer/semver": "^3.4"
    },
    "require-dev": {
        "pestphp/pest": "^3.8",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.3"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "MWGuerra\\InteractiveUpgrader\\InteractiveUpgraderServiceProvider"
            ]
        }
    }
}
