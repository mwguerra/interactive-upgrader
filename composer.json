{
    "name": "mwguerra/interactive-upgrader",
    "description": "A CLI tool that handles both Composer and npm dependencies for Laravel projects.",
    "type": "library",
    "version": "0.0.1",
    "license": "MIT",
    "keywords": ["laravel", "composer", "npm", "dependencies", "upgrade", "interactive"],
    "autoload": {
        "psr-4": {
            "MWGuerra\\InteractiveUpgrader\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Marcelo Guerra",
            "email": "mwguerra@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "symfony/console": "^7.0",
        "symfony/process": "^7.0",
        "guzzlehttp/guzzle": "^7.0",
        "composer/composer": "^2.8",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "composer/semver": "^3.4"
    },
    "require-dev": {
        "pestphp/pest": "^3.8"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MWGuerra\\InteractiveUpgrader\\InteractiveUpgraderServiceProvider"
            ]
        }
    }
}
